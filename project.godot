; Engine configuration file.
; BOX DEFENSE
; Edit primarily through the Godot editor when possible.

config_version=5

[application]

config/name="BOX DEFENSE"
run/main_scene="res://scenes/ui/main_menu.tscn"

[autoload]

SaveManager="*res://scripts/core/save_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=360
window/size/window_height_override=640
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.035, 0.04, 1)

[physics]

common/physics_ticks_per_second=60
